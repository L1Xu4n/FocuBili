<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 只用于区分 Wi-Fi、移动网络和有线网络，从而应用用户选择的默认清晰度。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13 起发送专注继续提醒前需要用户运行时授权。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12 起允许用户授权精确闹钟；未授权时仍会安全回退为后台可唤醒提醒。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 设备重启会清空 AlarmManager；接收开机完成后从私有待办中恢复尚未到期的提醒。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 勿扰模式属于 Android 特殊访问权限，应用只在用户开启设置后才会请求。 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:label="焦点哔哩"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <!-- 仅接收系统画中画 PendingIntent；不对其他应用导出，避免外部任意控制播放。 -->
        <receiver
            android:name=".PictureInPicturePlaybackActionReceiver"
            android:exported="false" />
        <!-- 只接收本应用安排的专注提醒闹钟，不允许其他应用直接调用。 -->
        <receiver
            android:name=".FocusReminderReceiver"
            android:exported="false" />
        <!-- 系统重启、应用升级或重新授予精确闹钟权限后恢复尚未到期的提醒。 -->
        <receiver
            android:name=".FocusReminderRestoreReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- 深链由焦点哔哩自己的 MethodChannel 解析，避免 Flutter 把完整 URL 当命名路由。 -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 接收 B站 App 分享出的纯文本，让用户可以从系统分享面板直接选择焦点哔哩。 -->
            <intent-filter android:label="焦点哔哩">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- B站网页唤起 bilibili://video 时，让系统在官方客户端和焦点哔哩间选择。 -->
            <intent-filter android:label="焦点哔哩">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bilibili" android:host="video" />
            </intent-filter>
            <!-- 同时支持 QQ 或浏览器直接把标准 B站视频网页交给焦点哔哩。 -->
            <intent-filter android:label="焦点哔哩">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="bilibili.com" android:pathPrefix="/video/" />
                <data android:scheme="https" android:host="bilibili.com" android:pathPrefix="/video/" />
                <data android:scheme="http" android:host="www.bilibili.com" android:pathPrefix="/video/" />
                <data android:scheme="https" android:host="www.bilibili.com" android:pathPrefix="/video/" />
                <data android:scheme="http" android:host="m.bilibili.com" android:pathPrefix="/video/" />
                <data android:scheme="https" android:host="m.bilibili.com" android:pathPrefix="/video/" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
